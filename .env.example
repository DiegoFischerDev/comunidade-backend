# Copie para .env e ajuste os valores
# cp .env.example .env

PORT=3001
NODE_ENV=development

# Postgres (com Docker: docker compose up -d na pasta comunidade)
# Porta 5433 no host para não conflitar com outro Postgres
DATABASE_URL="postgresql://comunidade:comunidade@localhost:5433/comunidade?schema=public"

# JWT (gere um segredo forte em produção)
JWT_SECRET="seu-segredo-jwt-mínimo-32-caracteres"

# URL do frontend (CORS e link na mensagem de boas-vindas por WhatsApp após registo)
FRONTEND_URL="http://localhost:3000"

# Confirmação de registo via WhatsApp (receiver Evolution → POST /auth/whatsapp/confirm)
# Mesmo valor que COMMUNITY_INTERNAL_SECRET no projeto wa-verify-receiver
COMMUNITY_INTERNAL_SECRET="gere-um-segredo-longo"

# Envio de respostas pelo WhatsApp (Evolution API)
EVOLUTION_API_URL="https://evo-comunidade.seudominio.com"
EVOLUTION_INSTANCE="comunidade"
EVOLUTION_API_KEY="sua-api-key-evolution"
# Número wa.me no link de registo (sem +)
WHATSAPP_REGISTRATION_NUMBER="351927398547"

# Stripe (pagamento único – cartão, MB WAY, Pix; anuidade 1 ano definida no backend)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# EUR (cartão e MB WAY): valor em cêntimos. Ex.: 2300 = 23,00 €
STRIPE_AMOUNT_EUR_CENTS="2300"
# Pix: valor em centavos (BRL). Ex.: 2300 = R$ 23,00
STRIPE_PIX_AMOUNT_BRL="2300"

# Taxa para novo agendamento Cal.com (após consumir a chamada incluída)
STRIPE_RAFA_CALL_EUR_CENTS="2000"
STRIPE_RAFA_CALL_PIX_BRL="2000"

# Webhook Calendly — URL pública: POST /webhooks/calendly (corpo raw JSON)
# Chave de assinatura (HMAC) fornecida no Calendly (Webhook Signing Key)
CALENDLY_WEBHOOK_SIGNING_KEY=""

# Dashboard admin: listar agendamentos do dia (API Calendly v2)
# PAT com scheduled_events:read, users:read, organizations:read (ou scope de organização)
CALENDLY_API_TOKEN=""
# URI completa da organização (equipa) — ver GET /users/me → current_organization
CALENDLY_ORGANIZATION_URI=""
# Em alternativa, conta pessoal sem org: URI do utilizador (GET /users/me → resource.uri)
# CALENDLY_USER_URI=https://api.calendly.com/users/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Opcional: fuso para o “dia” (predefinição Europe/Lisbon)
# CALENDLY_ADMIN_TZ=Europe/Lisbon

# URL do evento Cal.com (opcional se usar NEXT_PUBLIC_CALCOM_EMBED_URL no mesmo .env no Docker — ver compose)
CALCOM_EMBED_URL=""
