# Copie para .env e ajuste os valores
# cp .env.example .env

PORT=3001
NODE_ENV=development

# Postgres (com Docker: docker compose up -d na pasta comunidade)
# Porta 5433 no host para não conflitar com outro Postgres
DATABASE_URL="postgresql://comunidade:comunidade@localhost:5433/comunidade?schema=public"

# JWT (gere um segredo forte em produção)
JWT_SECRET="seu-segredo-jwt-mínimo-32-caracteres"

# URL do frontend (CORS e link na mensagem de boas-vindas por WhatsApp após registo)
FRONTEND_URL="http://localhost:3000"

# Opcional: outras rotas server-side que precisem da URL absoluta da API.
# Imóveis em disco gravam /uploads/... na BD; o frontend usa NEXT_PUBLIC_API_URL.
PUBLIC_API_BASE_URL="http://localhost:3001"

# Cloudflare R2 (S3) — opcional; sem isto, imagens WebP ficam em uploads/houses/
# R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# R2_BUCKET="comunidade-media"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_BASE_URL="https://media.seudominio.com"

# Confirmação de registo via WhatsApp (receiver Evolution → POST /auth/whatsapp/confirm)
# Mesmo valor que COMMUNITY_INTERNAL_SECRET no projeto wa-verify-receiver
COMMUNITY_INTERNAL_SECRET="gere-um-segredo-longo"

# Envio de respostas pelo WhatsApp (Evolution API)
EVOLUTION_API_URL="https://evo-comunidade.seudominio.com"
EVOLUTION_INSTANCE="comunidade"
# Instância extra para chatbot/automação (opcional)
EVOLUTION_INSTANCE_SECONDARY="comunidade-2"
# Define manualmente a instância preferida de envio (opcional)
EVOLUTION_ACTIVE_INSTANCE="comunidade"
# 1=true: tenta fallback automático na secundária quando a principal falhar
EVOLUTION_FAILOVER_ENABLED="1"
EVOLUTION_API_KEY="sua-api-key-evolution"
# Opcional: recusa enviar vídeo em base64 acima deste tamanho (evita 413 do nginx na frente da Evolution).
# Ex.: 4000000 ≈ 3 MB em ficheiro. Se não definires, só há limite de 16 MB (WhatsApp) e fallback em caso de 413.
# EVOLUTION_MAX_MEDIA_BASE64_CHARS="4000000"
# Não tentar vídeo em base64 acima disto (bytes do ficheiro) — JSON enorme → 413 no nginx. Omissão 2 MB.
# EVOLUTION_VIDEO_MAX_BASE64_FALLBACK_BYTES="2097152"
# Timeout (ms) do fetch do backend para a Evolution (vídeos grandes a processar). Omissão 180000 (3 min).
# EVOLUTION_REQUEST_TIMEOUT_MS="180000"
# Tempo máximo (ms) a aguardar até a URL pública do vídeo responder 200 antes de chamar a Evolution (R2/CDN).
# Omissão: ~20s vídeos pequenos, ~90s vídeos grandes (ver WHATSAPP_LARGE_VIDEO_BYTES no código).
# MEDIA_PUBLIC_URL_READY_MAX_WAIT_MS="90000"
# No nginx do host da Evolution API, aumenta o corpo do pedido, ex.: client_max_body_size 50m;
# e proxy_read_timeout / send_timeout altos o suficiente para a API descarregar o vídeo da URL pública (ex.: 120s).
# no server ou location que faz proxy para a API.

# JID do grupo WhatsApp para anúncios de imóveis (relocation), ex. 120363...@g.us
# EVOLUTION_HOUSES_RELOCATION_GROUP_JID="120363...@g.us"
# EVOLUTION_HOUSES_GROUP_JID="120363...@g.us"

# Número wa.me no link de registo (sem +)
WHATSAPP_REGISTRATION_NUMBER="351927398547"
# Número extra para chatbot/automação (opcional, sem +)
WHATSAPP_REGISTRATION_NUMBER_SECONDARY="351900000000"

# Stripe (pagamento único – cartão, MB WAY, Pix; anuidade 1 ano definida no backend)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# EUR (cartão e MB WAY): valor em cêntimos. Ex.: 2300 = 23,00 €
STRIPE_AMOUNT_EUR_CENTS="2300"
# Pix: valor em centavos (BRL). Ex.: 2300 = R$ 23,00
STRIPE_PIX_AMOUNT_BRL="2300"

# Taxa para novo agendamento Cal.com (após consumir a chamada incluída)
STRIPE_RAFA_CALL_EUR_CENTS="2000"
STRIPE_RAFA_CALL_PIX_BRL="2000"

# Agendamento interno (Rafa Call)
RAFA_CALL_DURATION_MINUTES=30
RAFA_CALL_BUFFER_MINUTES=10
# Janela padrão (dias) para mostrar disponibilidade no popup
RAFA_CALL_WINDOW_DAYS=14
# Horários por dia (timezone do utilizador); array de ranges [início,fim]
# Ex.: {"mon":[["10:00","18:00"]],"tue":[["10:00","18:00"]],...,"sat":[],"sun":[]}
# RAFA_CALL_WORKING_HOURS_JSON={"mon":[["10:00","18:00"]],"tue":[["10:00","18:00"]],"wed":[["10:00","18:00"]],"thu":[["10:00","18:00"]],"fri":[["10:00","18:00"]],"sat":[],"sun":[]}
RAFA_CALL_WORKING_HOURS_JSON={"mon":[["19:00","22:00"]],"tue":[],"wed":[["19:00","22:00"]],"thu":[],"fri":[["19:00","22:00"]],"sat":[["15:00","19:00"]],"sun":[]}