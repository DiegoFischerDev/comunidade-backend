# Documentação: README.md — «Variáveis de ambiente»
# cp .env.example .env

PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://comunidade:comunidade@localhost:5433/comunidade?schema=public"

JWT_SECRET="seu-segredo-jwt-mínimo-32-caracteres"

# URL pública do Next (CORS, links, Stripe). Em produção é obrigatório.
# Também define o domínio em «Mais detalhes: …/ofertas-trabalho/12» nas mensagens WhatsApp de vagas.
FRONTEND_URL="http://localhost:3000"
# Origens CORS adicionais (vírgula). Se vazio, usa FRONTEND_URL + http://localhost:3000
# CORS_ORIGINS="https://comunidade.exemplo.com,https://stage.exemplo.com"
PUBLIC_API_BASE_URL="http://localhost:3001"

RESEND_API_KEY=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# ADMIN_NAME=Admin
# ADMIN_WHATSAPP=

COMMUNITY_INTERNAL_SECRET="gere-um-segredo-longo"

# OpenAI — Whatsapp scan (imóveis), criação de imóvel por descrição, ofertas de trabalho (extração de texto).
OPENAI_API_KEY=""
# Modelo usado na classificação/extração (default: gpt-4o-mini).
OPENAI_MODEL="gpt-4o-mini"
# Timeout (ms) das chamadas à OpenAI (default: 45000).
# OPENAI_REQUEST_TIMEOUT_MS="45000"
# Pré-filtro barato (regex) antes de chamar a OpenAI (poupa tokens). "0" desliga.
# WHATSAPP_SCAN_PREFILTER="1"
# Janela (min) em que as imagens/vídeo aguardam o texto do anúncio do mesmo remetente (default: 5).
# WHATSAPP_SCAN_MEDIA_WINDOW_MIN="5"
# Tolerância (seg): mídia postada até X seg DEPOIS do texto ainda é anexada ao imóvel (default: 5).
# WHATSAPP_SCAN_MEDIA_AFTER_TEXT_GRACE_SEC="5"
# Limite do body JSON do endpoint interno /whatsapp-scan/ingest (mídia em base64; default: 256mb).
# WHATSAPP_SCAN_INGEST_BODY_LIMIT="256mb"
# Log quando um remetente é ignorado pelo filtro de números monitorizados (debug).
# WHATSAPP_SCAN_LOG_SENDER="1"
# Ofertas de trabalho via WhatsApp (/ofertas-trabalho): log de remetentes ignorados.
# JOB_OFFER_WHATSAPP_LOG_SENDER="1"
# JOB_OFFER_WHATSAPP_LOG_INGEST="1"
# Whatsapp scan: atraso (ms) antes do compartilhamento automático aos grupos (default: 10000).
# WHATSAPP_SCAN_AUTO_SHARE_DELAY_MS="10000"

EVOLUTION_API_URL="https://evo-comunidade.seudominio.com"
EVOLUTION_INSTANCE="comunidade"
EVOLUTION_INSTANCE_SECONDARY="comunidade-2"
EVOLUTION_ACTIVE_INSTANCE="comunidade"
EVOLUTION_FAILOVER_ENABLED="1"
EVOLUTION_API_KEY="sua-api-key-evolution"
# Timeout (ms) backend→Evolution para sendMedia de vídeo (omissão 600000 = 10 min). Vídeos ~3 min + rede lenta.
# EVOLUTION_VIDEO_REQUEST_TIMEOUT_MS=600000
# EVOLUTION_REQUEST_TIMEOUT_MS=180000
# Se a URL da mídia for localhost/hostname interno, o backend faz GET e envia base64 à Evolution (imagem/documento). Máx. bytes (omissão 12 MiB).
# EVOLUTION_SEND_MEDIA_URL_FETCH_MAX_BYTES=12582912
# Opcional (legado). Envio relocation → WhatsApp: grupos na área admin «Anúncios de casas».
# EVOLUTION_HOUSES_RELOCATION_GROUP_JID="120363...@g.us"

WHATSAPP_REGISTRATION_NUMBER="351927398547"
WHATSAPP_REGISTRATION_NUMBER_SECONDARY="351900000000"

STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_AMOUNT_EUR_CENTS="2300"
# Centavos em reais (BRL) para Pix — não usar o valor em euros. Ex.: 13800 = R$ 138,00
STRIPE_PIX_AMOUNT_BRL="13800"

STRIPE_RAFA_CALL_EUR_CENTS="2000"
STRIPE_RAFA_CALL_PIX_BRL="2000"

RAFA_CALL_DURATION_MINUTES=30
RAFA_CALL_BUFFER_MINUTES=10
RAFA_CALL_WINDOW_DAYS=14
# Horários abaixo são neste fuso (omissão Europe/Lisbon); o utilizador vê convertido para o fuso dele.
# RAFA_CALL_WORKING_HOURS_TIMEZONE=Europe/Lisbon
RAFA_CALL_WORKING_HOURS_JSON={"mon":[["19:00","22:00"]],"tue":[],"wed":[["19:00","22:00"]],"thu":[],"fri":[["19:00","22:00"]],"sat":[["15:00","19:00"]],"sun":[]}

# Opcional: Cloudflare R2 (sem isto, media em disco em uploads/houses/)
# R2_ENDPOINT=…
# R2_BUCKET=…
# R2_ACCESS_KEY_ID=…
# R2_SECRET_ACCESS_KEY=…
# R2_PUBLIC_BASE_URL=…
