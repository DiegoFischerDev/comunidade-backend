generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum UserTier {
  VISITOR
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum SaleStatus {
  PENDING_PARTNER
  APPROVED
  REJECTED
}

enum CommissionPaymentStatus {
  PENDING
  PAID
}

enum CashbackPayoutMethod {
  MBWAY
  PIX
}

enum AffiliateCommissionStatus {
  PENDING
  PAID
}

enum AffiliateCommissionCurrency {
  EUR
  BRL
}

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  passwordHash               String    @map("password_hash")
  role                       Role      @default(USER)
  tier                       UserTier  @default(VISITOR) @map("tier")
  membershipExpiresAt        DateTime? @map("membership_expires_at")
  name                       String
  whatsapp                   String    @map("whatsapp")
  instagram                  String?   @map("instagram")
  profileImageUrl            String?   @map("profile_image_url")
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationCode      String?   @map("email_verification_code")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  resetPasswordCode          String?   @map("reset_password_code")
  resetPasswordExpiresAt     DateTime? @map("reset_password_expires_at")
  referredByAffiliateId      String?   @map("referred_by_affiliate_id")
  referredAt                 DateTime? @map("referred_at")
  referredByCodeSnapshot     String?   @map("referred_by_code_snapshot")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  subscription       Subscription?
  membershipPayments MembershipPayment[]
  partner            Partner?
  affiliateProfile AffiliateProfile?
  referredByAffiliate AffiliateProfile? @relation("AffiliateReferrals", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  leads        Lead[]
  sales        Sale[]
  salesCreated Sale[]   @relation("SaleCreatedBy")
  affiliateCommissionsFromReferrals AffiliateCommission[] @relation("AffiliateCommissionReferredUser")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  status               SubscriptionStatus @default(ACTIVE)
  validUntil           DateTime           @map("valid_until")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
}

/// Pagamento de anuidade contabilizado no total admin (histórico imune a mudanças de preço em env).
model MembershipPayment {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String?  @unique @map("stripe_checkout_session_id")
  stripeInvoiceId         String?  @unique @map("stripe_invoice_id")
  amountCreditedEur       Decimal  @map("amount_credited_eur") @db.Decimal(12, 2)
  stripeCurrency          String?  @map("stripe_currency")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("membership_payments")
}

model Partner {
  id                   String           @id @default(cuid())
  userId               String           @unique @map("user_id")
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  whatsapp             String
  logoUrl              String?          @map("logo_url")
  shortDescription     String?          @map("short_description")
  fullDescription      String?          @map("full_description")
  rpmCommissionPercent Float?           @map("rpm_commission_percent")
  backgroundImageUrl   String?          @map("background_image_url")
  catalogImageUrls     String[]         @default([]) @map("catalog_image_urls")
  instagram            String?          @map("instagram")
  /// Dados de faturação (para emissão de fatura da comissão em Portugal)
  billingName          String?          @map("billing_name")
  billingNif           String?          @map("billing_nif")
  billingAddress       String?          @map("billing_address")
  billingPostalCode    String?          @map("billing_postal_code")
  categoryId           String?          @map("category_id")
  category             ProductCategory? @relation(fields: [categoryId], references: [id])
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  services Service[]
  leads    Lead[]
  sales    Sale[]
}

model ProductCategory {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  description        String?  @map("description")
  backgroundImageUrl String?  @map("background_image_url")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  services Service[]
  partners Partner[]
}

model Service {
  id                      String           @id @default(cuid())
  partnerId               String           @map("partner_id")
  partner                 Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  categoryId              String?          @map("category_id")
  category                ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title                   String
  description             String?
  imageUrl                String?          @map("image_url")
  price                   String?
  priceOnRequest          Boolean          @default(false) @map("price_on_request")
  commission              String?          @map("commission")
  /// Valor de cashback em euros definido pelo admin para este serviço
  cashbackEuro            Float?           @map("cashback_euro")
  /// Indica se o serviço (ou o seu preço) está pendente de aprovação do admin
  pendingApproval         Boolean          @default(false) @map("pending_approval")
  whatsappMessageTemplate String?          @map("whatsapp_message_template")
  sortOrder               Int              @default(0) @map("sort_order")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  sales Sale[]

  @@index([categoryId])
  @@index([partnerId])
}

model Lead {
  id        String   @id @default(cuid())
  partnerId String   @map("partner_id")
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([partnerId])
  @@index([userId])
  @@unique([partnerId, userId], name: "lead_partner_user_unique")
}

model Sale {
  id                     String                  @id @default(cuid())
  partnerId              String                  @map("partner_id")
  partner                Partner                 @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId                 String?                 @map("user_id")
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByUserId        String?                 @map("created_by_user_id")
  createdByUser          User?                   @relation("SaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  serviceId              String?                 @map("service_id")
  service                Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceTitle           String?                 @map("service_title")
  month                  Int
  year                   Int
  amount                 Float                   @map("amount")
  commissionEuro         Float                   @map("commission_euro")
  status                 SaleStatus              @default(PENDING_PARTNER)
  commissionPaymentStatus CommissionPaymentStatus @default(PENDING) @map("commission_payment_status")
  /// Valor efetivamente pago pelo parceiro de comissão, em euros
  commissionPaidEuro     Float?                  @map("commission_paid_euro")
  /// Se o parceiro solicitou emissão de fatura pela comissão
  wantsInvoice           Boolean                 @default(false) @map("wants_invoice")
  /// Dados para emissão de fatura (Portugal)
  invoiceName            String?                 @map("invoice_name")
  invoiceNif             String?                 @map("invoice_nif")
  invoiceAddress         String?                 @map("invoice_address")
  invoicePostalCode      String?                 @map("invoice_postal_code")
  invoiceRequestedAt     DateTime?               @map("invoice_requested_at")
  /// URL do PDF da fatura enviada ao parceiro
  invoicePdfUrl          String?                 @map("invoice_pdf_url")
  /// Data/hora em que a fatura foi enviada ao parceiro
  invoiceSentAt          DateTime?               @map("invoice_sent_at")
  cashbackRequestedAt    DateTime?               @map("cashback_requested_at")
  cashbackPayoutMethod   CashbackPayoutMethod?   @map("cashback_payout_method")
  cashbackMbwayNumber    String?                 @map("cashback_mbway_number")
  cashbackMbwayName      String?                 @map("cashback_mbway_name")
  cashbackPixKey         String?                 @map("cashback_pix_key")
  cashbackPixName        String?                 @map("cashback_pix_name")
  /// Comprovante do pagamento do cashback (admin → usuário)
  cashbackPaymentProofUrl String?                @map("cashback_payment_proof_url")
  cashbackPaidAt         DateTime?               @map("cashback_paid_at")
  paymentProofUrl        String?                 @map("payment_proof_url")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([userId])
  @@index([status])
  @@index([commissionPaymentStatus])
}

model AffiliateProfile {
  id               String               @id @default(cuid())
  userId           String               @unique @map("user_id")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramHandle  String               @map("instagram_handle")
  affiliateCode    String               @unique @map("affiliate_code")
  payoutMethod     CashbackPayoutMethod @default(MBWAY) @map("payout_method")
  mbwayNumber      String?              @map("mbway_number")
  mbwayName        String?              @map("mbway_name")
  pixKey           String?              @map("pix_key")
  pixName          String?              @map("pix_name")
  termsAcceptedAt  DateTime             @map("terms_accepted_at")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  referredUsers User[] @relation("AffiliateReferrals")
  commissions  AffiliateCommission[]
}

model AffiliateCommission {
  id             String                    @id @default(cuid())
  affiliateId    String                    @map("affiliate_id")
  affiliate      AffiliateProfile          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String                    @unique @map("referred_user_id")
  referredUser   User                      @relation("AffiliateCommissionReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  amount         Float
  currency       AffiliateCommissionCurrency
  status         AffiliateCommissionStatus @default(PENDING)
  paymentProofUrl String?                  @map("payment_proof_url")
  paidAt         DateTime?                 @map("paid_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@index([affiliateId, status])
}
