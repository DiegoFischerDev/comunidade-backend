generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum UserTier {
  VISITOR
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum CashbackPayoutMethod {
  MBWAY
  PIX
}

enum AffiliateCommissionStatus {
  PENDING
  PAID
}

enum AffiliateCommissionCurrency {
  EUR
  BRL
}

enum RegistrationChannel {
  EMAIL
  WHATSAPP
}

enum RafaCallBookingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum RafaCallBookingOrigin {
  USER_PAID
  AFFILIATE_FREE
}

enum SupportTicketStatus {
  REGISTERED
  IN_REVIEW
  DONE
}

enum PartnerHouseStatus {
  AVAILABLE
  UNAVAILABLE
}

enum PartnerHouseTypology {
  T1
  T2
  T3
  T4
  T5
  QUARTO_AP_COMPARTILHADO
}

model WhatsappRegistrationRequest {
  id                    String   @id @default(cuid())
  code                  String   @unique
  /** Token opaco devolvido ao browser para polling após confirmação no WhatsApp */
  browserSessionToken   String   @unique @map("browser_session_token")
  name                  String
  passwordHash          String   @map("password_hash")
  affiliateCodeSnapshot String?  @map("affiliate_code_snapshot")
  indicadoPor           String?  @map("indicado_por")
  referredByAffiliateId String?  @map("referred_by_affiliate_id")
  expiresAt             DateTime @map("expires_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("whatsapp_registration_requests")
}

/** Ligação temporária browser ↔ utilizador após confirmação WA (troca única por JWT) */
model WhatsappRegistrationBrowserHandoff {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @map("session_token")
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")

  @@index([expiresAt])
  @@map("whatsapp_registration_browser_handoffs")
}

model User {
  id                         String    @id @default(cuid())
  email                      String?   @unique
  passwordHash               String    @map("password_hash")
  role                       Role      @default(USER)
  tier                       UserTier  @default(VISITOR) @map("tier")
  membershipExpiresAt        DateTime? @map("membership_expires_at")
  name                       String
  whatsapp                   String    @unique @map("whatsapp")
  instagram                  String?   @map("instagram")
  profileImageUrl            String?   @map("profile_image_url")
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationCode      String?   @map("email_verification_code")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  registrationChannel        RegistrationChannel @default(EMAIL) @map("registration_channel")
  whatsappVerificationCode      String?   @map("whatsapp_verification_code")
  whatsappVerificationExpiresAt DateTime? @map("whatsapp_verification_expires_at")
  resetPasswordCode          String?   @map("reset_password_code")
  resetPasswordExpiresAt     DateTime? @map("reset_password_expires_at")
  referredByAffiliateId      String?   @map("referred_by_affiliate_id")
  referredAt                 DateTime? @map("referred_at")
  referredByCodeSnapshot     String?   @map("referred_by_code_snapshot")
  indicadoPor                String?   @map("indicado_por")
  /** Pode abrir Cal.com para marcar/reagendar (1º acesso com membro ou após pagar taxa). */
  rafaCallSchedulingUnlocked Boolean   @default(false) @map("rafa_call_scheduling_unlocked")
  /** Origem do desbloqueio atual do agendamento (pago vs afiliado). */
  rafaCallUnlockOrigin       RafaCallBookingOrigin? @map("rafa_call_unlock_origin")
  /** Início da chamada agendada (webhook Calendly). */
  rafaCallSlotStartsAt       DateTime? @map("rafa_call_slot_starts_at")
  /** Fim da janela da chamada agendada (webhook Calendly); após isto o direito consome-se. */
  rafaCallSlotEndsAt         DateTime? @map("rafa_call_slot_ends_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  rafaCallBookings      RafaCallBooking[]
  rafaCallBlockedSlotsCreated RafaCallBlockedSlot[] @relation("RafaCallBlockedSlotsCreated")

  subscription       Subscription?
  membershipPayments MembershipPayment[]
  partner            Partner?
  affiliateProfile AffiliateProfile?
  referredByAffiliate AffiliateProfile? @relation("AffiliateReferrals", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  leads        Lead[]
  affiliateCommissionsFromReferrals AffiliateCommission[] @relation("AffiliateCommissionReferredUser")
  partnerSales PartnerSale[]
  whatsappRegistrationBrowserHandoffs WhatsappRegistrationBrowserHandoff[]
  supportTickets SupportTicket[]
  immigrationChecklist ImmigrationChecklist?
}

model ImmigrationChecklist {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** JSON com o estado do checklist (checkboxes, selects, datas, notas, etc.) */
  data      Json     @default("{}")
  /** versão do template de checklist (para migrações futuras) */
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("immigration_checklists")
}

model RafaCallBooking {
  id                     String               @id @default(cuid())
  userId                 String               @map("user_id")
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 RafaCallBookingStatus @default(SCHEDULED)
  origin                 RafaCallBookingOrigin @default(USER_PAID)
  /** UTC. */
  startsAt               DateTime             @map("starts_at")
  /** UTC. */
  endsAt                 DateTime             @map("ends_at")
  /** Timezone do utilizador no momento do agendamento (ex.: America/Sao_Paulo). */
  timezone               String
  /** Cadeia de histórico de reagendamentos (booking anterior). */
  rescheduledFromBookingId String?            @map("rescheduled_from_booking_id")
  rescheduledFromBooking   RafaCallBooking?   @relation("RafaCallRescheduleChain", fields: [rescheduledFromBookingId], references: [id], onDelete: SetNull)
  reschedulesTo            RafaCallBooking[]  @relation("RafaCallRescheduleChain")
  cancelledAt             DateTime?           @map("cancelled_at")
  cancelReason            String?             @map("cancel_reason")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("rafa_call_bookings")
}

model RafaCallBlockedSlot {
  id              String   @id @default(cuid())
  /** Intervalo em UTC. */
  startsAt        DateTime @map("starts_at")
  /** Intervalo em UTC. */
  endsAt          DateTime @map("ends_at")
  /** Motivo opcional (ex.: "férias", "indisponível"). */
  reason          String?  @map("reason")
  /** Quem bloqueou (admin). */
  createdByUserId String   @map("created_by_user_id")
  createdByUser   User     @relation("RafaCallBlockedSlotsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([endsAt])
  @@index([createdByUserId])
  @@map("rafa_call_blocked_slots")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  status               SubscriptionStatus @default(ACTIVE)
  validUntil           DateTime           @map("valid_until")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
}

/// Pagamento de anuidade contabilizado no total admin (histórico imune a mudanças de preço em env).
model MembershipPayment {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String?  @unique @map("stripe_checkout_session_id")
  stripeInvoiceId         String?  @unique @map("stripe_invoice_id")
  amountCreditedEur       Decimal  @map("amount_credited_eur") @db.Decimal(12, 2)
  stripeCurrency          String?  @map("stripe_currency")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("membership_payments")
}

model Partner {
  id                   String           @id @default(cuid())
  userId               String           @unique @map("user_id")
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  whatsapp             String
  logoUrl              String?          @map("logo_url")
  shortDescription     String?          @map("short_description")
  fullDescription      String?          @map("full_description")
  rpmCommissionPercent Float?           @map("rpm_commission_percent")
  backgroundImageUrl   String?          @map("background_image_url")
  catalogImageUrls     String[]         @default([]) @map("catalog_image_urls")
  instagram            String?          @map("instagram")
  /// Dados de faturação (para emissão de fatura da comissão em Portugal)
  billingName          String?          @map("billing_name")
  billingNif           String?          @map("billing_nif")
  billingAddress       String?          @map("billing_address")
  billingPostalCode    String?          @map("billing_postal_code")
  categoryId           String?          @map("category_id")
  category             ProductCategory? @relation(fields: [categoryId], references: [id])
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  services Service[]
  leads    Lead[]
  sales    PartnerSale[]
  houses   PartnerHouse[]
}

model PartnerHouse {
  id            String            @id @default(cuid())
  partnerId     String            @map("partner_id")
  partner       Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  typology      PartnerHouseTypology @map("typology")
  city          String
  availableFrom DateTime          @map("available_from")
  priceEur      String            @map("price_eur")
  /// Valor em euros (texto livre, ex. "500" ou "500,00")
  relocationFeeEur String         @map("relocation_fee_eur")
  /// Número de cauções exigidas para entrada (0–12)
  caucoesCount  Int               @default(0) @map("caucoes_count")
  /// Número de rendas antecipadas exigidas para entrada (0–12)
  rendasEntradaCount Int          @default(0) @map("rendas_entrada_count")
  /// Imóvel mobilado (sim/não)
  furnished     Boolean           @default(false) @map("furnished")
  // URLs públicas (WebP), ex. R2 ou /uploads/houses/
  imageUrls     String[]          @default([]) @map("image_urls")
  /// Foto principal (preview OG / cartões); deve existir em imageUrls. Opcional — usa-se a 1.ª imagem.
  coverImageUrl String?           @map("cover_image_url")
  /// Vídeo opcional na página pública (não enviado ao grupo WhatsApp)
  videoUrl      String?           @map("video_url")
  status        PartnerHouseStatus @default(AVAILABLE)
  whatsappSentAt DateTime?        @map("whatsapp_sent_at")
  whatsappError  String?          @map("whatsapp_error")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([partnerId, status])
  @@index([availableFrom])
  @@map("partner_houses")
}

model ProductCategory {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  shortDescription   String?  @map("description")
  fullDescription    String?  @map("full_description")
  backgroundImageUrl String?  @map("background_image_url")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  services Service[]
  partners Partner[]
}

model Service {
  id                      String           @id @default(cuid())
  partnerId               String           @map("partner_id")
  partner                 Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  categoryId              String?          @map("category_id")
  category                ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title                   String
  description             String?
  imageUrl                String?          @map("image_url")
  price                   String?
  priceOnRequest          Boolean          @default(false) @map("price_on_request")
  rpmCommissionEur        String?          @map("rpm_commission_eur")
  whatsappMessageTemplate String?          @map("whatsapp_message_template")
  sortOrder               Int              @default(0) @map("sort_order")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  sales PartnerSale[]

  @@index([categoryId])
  @@index([partnerId])
}

enum PartnerSaleCommissionPaymentStatus {
  PENDING
  PAID
}

model PartnerSale {
  id                 String   @id @default(cuid())
  partnerId           String   @map("partner_id")
  partner             Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId           String   @map("service_id")
  service             Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  amountEur           String   @map("amount_eur")

  commissionPaymentStatus PartnerSaleCommissionPaymentStatus @default(PENDING) @map("commission_payment_status")
  commissionSuggestedEur  String?  @map("commission_suggested_eur")
  commissionPaidEur       String?  @map("commission_paid_eur")

  wantsInvoice       Boolean  @default(false) @map("wants_invoice")
  invoiceName        String?  @map("invoice_name")
  invoiceNif         String?  @map("invoice_nif")
  invoiceAddress     String?  @map("invoice_address")
  invoicePostalCode  String?  @map("invoice_postal_code")
  invoiceRequestedAt DateTime? @map("invoice_requested_at")

  stripeCheckoutSessionId String? @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @unique @map("stripe_payment_intent_id")
  paidAt                 DateTime? @map("paid_at")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([userId])
  @@index([serviceId])
  @@index([commissionPaymentStatus])
  @@map("partner_sales")
}

model Lead {
  id        String   @id @default(cuid())
  partnerId String   @map("partner_id")
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([partnerId])
  @@index([userId])
  @@unique([partnerId, userId], name: "lead_partner_user_unique")
}

model AffiliateProfile {
  id               String               @id @default(cuid())
  userId           String               @unique @map("user_id")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramHandle  String               @map("instagram_handle")
  affiliateCode    String               @unique @map("affiliate_code")
  payoutMethod     CashbackPayoutMethod @default(MBWAY) @map("payout_method")
  mbwayNumber      String?              @map("mbway_number")
  mbwayName        String?              @map("mbway_name")
  pixKey           String?              @map("pix_key")
  pixName          String?              @map("pix_name")
  termsAcceptedAt  DateTime             @map("terms_accepted_at")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  referredUsers User[] @relation("AffiliateReferrals")
  commissions  AffiliateCommission[]
}

model AffiliateCommission {
  id             String                    @id @default(cuid())
  affiliateId    String                    @map("affiliate_id")
  affiliate      AffiliateProfile          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String                    @unique @map("referred_user_id")
  referredUser   User                      @relation("AffiliateCommissionReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  amount         Float
  currency       AffiliateCommissionCurrency
  status         AffiliateCommissionStatus @default(PENDING)
  paymentProofUrl String?                  @map("payment_proof_url")
  paidAt         DateTime?                 @map("paid_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@index([affiliateId, status])
}

model SupportTicket {
  id         String             @id @default(cuid())
  userId     String             @map("user_id")
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     SupportTicketStatus @default(REGISTERED)
  message    String
  adminReply String?            @map("admin_reply")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("support_tickets")
}
