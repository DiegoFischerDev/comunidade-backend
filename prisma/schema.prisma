generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum UserTier {
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum CashbackPayoutMethod {
  MBWAY
  PIX
}

enum AffiliateCommissionStatus {
  PENDING
  PAID
}

enum AffiliateCommissionCurrency {
  EUR
  BRL
}

enum RegistrationChannel {
  EMAIL
  WHATSAPP
}

enum RafaCallBookingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum RafaCallBookingOrigin {
  USER_PAID
  AFFILIATE_FREE
}

enum SupportTicketStatus {
  REGISTERED
  IN_REVIEW
  DONE
}

enum GrupoTesteMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum PartnerHousePublicationStatus {
  PUBLISHED
  HIDDEN
  TRASH
}

enum LeadGestoraStatus {
  inviavel
  pre_aprovado
  credito_aprovado
  agendado_escritura
  escritura_realizada
}

enum PartnerAdvertisingLedgerType {
  STRIPE_TOP_UP
  ADMIN_CREDIT
  PUBLICATION_DEBIT
}

enum PartnerHouseTypology {
  T0
  T1
  T2
  T3
  T4
  T5
  QUARTO_AP_COMPARTILHADO
}

enum PartnerHouseBusinessType {
  RENT
  SALE
}

/// Estado do processamento de uma mensagem capturada num grupo monitorizado (Whatsapp scan).
enum WhatsappScanMessageStatus {
  received
  ignored_sender
  ignored_not_listing
  created
  error
  // Mídia (imagem/vídeo) guardada à espera do texto do anúncio.
  media_stored
  // Mídia anexada a um imóvel criado a partir do texto do anúncio.
  media_attached
}

enum WhatsappScanMediaKind {
  IMAGE
  VIDEO
}

enum RedirectClickKind {
  CUSTOM_LINK
  HOUSE
}

enum PartnerReactionType {
  LIKE
  DISLIKE
}

model WhatsappRegistrationRequest {
  id                    String   @id @default(cuid())
  code                  String   @unique
  /**
   * Token opaco devolvido ao browser para polling após confirmação no WhatsApp
   */
  browserSessionToken   String   @unique @map("browser_session_token")
  name                  String
  passwordHash          String   @map("password_hash")
  affiliateCodeSnapshot String?  @map("affiliate_code_snapshot")
  indicadoPor           String?  @map("indicado_por")
  referredByAffiliateId String?  @map("referred_by_affiliate_id")
  expiresAt             DateTime @map("expires_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("whatsapp_registration_requests")
}

/**
 * Ligação temporária browser ↔ utilizador após confirmação WA (troca única por JWT)
 */
model WhatsappRegistrationBrowserHandoff {
  id           String    @id @default(cuid())
  sessionToken String    @unique @map("session_token")
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")

  @@index([expiresAt])
  @@map("whatsapp_registration_browser_handoffs")
}

/**
 * Dados de registo guardados até confirmação do pagamento da anuidade (checkout convidado).
 */
model PendingMembershipSignup {
  id                    String    @id @default(cuid())
  name                  String
  email                 String
  whatsapp              String
  passwordHash          String    @map("password_hash")
  affiliateCodeSnapshot String?   @map("affiliate_code_snapshot")
  indicadoPor           String?   @map("indicado_por")
  referredByAffiliateId String?   @map("referred_by_affiliate_id")
  existingUserId        String?   @map("existing_user_id")
  stripeSessionId       String?   @unique @map("stripe_session_id")
  expiresAt             DateTime  @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")
  createdUserId         String?   @map("created_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([whatsapp])
  @@index([expiresAt])
  @@map("pending_membership_signups")
}

/**
 * Dados de registo guardados até confirmação do pagamento da taxa de agendamento (checkout convidado).
 */
model PendingRafacallSignup {
  id              String    @id @default(cuid())
  name            String
  email           String
  whatsapp        String
  passwordHash    String    @map("password_hash")
  existingUserId  String?   @map("existing_user_id")
  stripeSessionId String?   @unique @map("stripe_session_id")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdUserId   String?   @map("created_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([whatsapp])
  @@index([expiresAt])
  @@map("pending_rafacall_signups")
}

/**
 * Troca única de JWT após pagamento no checkout convidado (session_id do Stripe).
 */
model MembershipCheckoutHandoff {
  id              String    @id @default(cuid())
  stripeSessionId String    @unique @map("stripe_session_id")
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")

  @@index([expiresAt])
  @@map("membership_checkout_handoffs")
}

model User {
  id                            String                 @id @default(cuid())
  email                         String?                @unique
  passwordHash                  String                 @map("password_hash")
  role                          Role                   @default(USER)
  tier                          UserTier               @default(MEMBER) @map("tier")
  membershipExpiresAt           DateTime?              @map("membership_expires_at")
  name                          String
  whatsapp                      String                 @unique @map("whatsapp")
  instagram                     String?                @map("instagram")
  profileImageUrl               String?                @map("profile_image_url")
  emailVerifiedAt               DateTime?              @map("email_verified_at")
  emailVerificationCode         String?                @map("email_verification_code")
  emailVerificationExpiresAt    DateTime?              @map("email_verification_expires_at")
  registrationChannel           RegistrationChannel    @default(EMAIL) @map("registration_channel")
  whatsappVerificationCode      String?                @map("whatsapp_verification_code")
  whatsappVerificationExpiresAt DateTime?              @map("whatsapp_verification_expires_at")
  resetPasswordCode             String?                @map("reset_password_code")
  resetPasswordExpiresAt        DateTime?              @map("reset_password_expires_at")
  referredByAffiliateId         String?                @map("referred_by_affiliate_id")
  referredAt                    DateTime?              @map("referred_at")
  referredByCodeSnapshot        String?                @map("referred_by_code_snapshot")
  indicadoPor                   String?                @map("indicado_por")
  /**
   * Pode abrir Cal.com para marcar/reagendar (1º acesso com membro ou após pagar taxa).
   */
  rafaCallSchedulingUnlocked    Boolean                @default(false) @map("rafa_call_scheduling_unlocked")
  /**
   * Origem do desbloqueio atual do agendamento (pago vs afiliado).
   */
  rafaCallUnlockOrigin          RafaCallBookingOrigin? @map("rafa_call_unlock_origin")
  /**
   * Início da chamada agendada (webhook Calendly).
   */
  rafaCallSlotStartsAt          DateTime?              @map("rafa_call_slot_starts_at")
  /**
   * Fim da janela da chamada agendada (webhook Calendly); após isto o direito consome-se.
   */
  rafaCallSlotEndsAt            DateTime?              @map("rafa_call_slot_ends_at")
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")

  rafaCallBookings            RafaCallBooking[]
  rafaCallBlockedSlotsCreated RafaCallBlockedSlot[] @relation("RafaCallBlockedSlotsCreated")

  subscription                        Subscription?
  membershipPayments                  MembershipPayment[]
  rafaCallUnlockPayments              RafaCallUnlockPayment[]
  partner                             Partner?
  affiliateProfile                    AffiliateProfile?
  referredByAffiliate                 AffiliateProfile?                    @relation("AffiliateReferrals", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  affiliateCommissionsFromReferrals   AffiliateCommission[]                @relation("AffiliateCommissionReferredUser")
  partnerSales                        PartnerSale[]
  whatsappRegistrationBrowserHandoffs WhatsappRegistrationBrowserHandoff[]
  membershipCheckoutHandoffs          MembershipCheckoutHandoff[]
  supportTickets                      SupportTicket[]
  immigrationChecklist                ImmigrationChecklist?
  partnerReactions                    PartnerReaction[]
  partnerComments                     PartnerComment[]
  grupoTesteMessages                  GrupoTesteMessage[]
}

/**
 * Mensagens guardadas pelo admin para testar envio Evolution → grupo WhatsApp.
 */
model GrupoTesteMessage {
  id             String                  @id @default(cuid())
  description    String                  @db.Text
  imageUrls      String[]                @map("image_urls")
  videoUrl       String?                 @map("video_url")
  /**
   * JID opcional guardado no registo (o envio usa o JID indicado no pedido «Enviar»).
   */
  targetGroupJid String?                 @map("target_group_jid") @db.VarChar(160)
  status         GrupoTesteMessageStatus @default(PENDING)
  sentAt         DateTime?               @map("sent_at")
  whatsappError  String?                 @map("whatsapp_error") @db.Text
  createdById    String                  @map("created_by_id")
  createdBy      User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("grupo_teste_messages")
}

/**
 * Contacto WhatsApp sem conta na plataforma (legado; pode ser reutilizado no futuro).
 */
model Visitor {
  id        String   @id @default(cuid())
  whatsapp  String   @unique @map("whatsapp")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("visitors")
}

model ImmigrationChecklist {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * JSON com o estado do checklist (checkboxes, selects, datas, notas, etc.)
   */
  data      Json     @default("{}")
  /**
   * versão do template de checklist (para migrações futuras)
   */
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("immigration_checklists")
}

model RafaCallBooking {
  id                       String                @id @default(cuid())
  /**
   * Utilizador autenticado (legacy/admin). Nos novos fluxos guest, fica null.
   */
  userId                   String?               @map("user_id")
  user                     User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Nome fornecido pelo guest no checkout.
   */
  guestName                String?               @map("guest_name")
  /**
   * WhatsApp normalizado (só dígitos, com indicativo) — identidade do guest.
   */
  guestWhatsapp            String?               @map("guest_whatsapp")
  status                   RafaCallBookingStatus @default(SCHEDULED)
  origin                   RafaCallBookingOrigin @default(USER_PAID)
  /**
   * UTC.
   */
  startsAt                 DateTime              @map("starts_at")
  /**
   * UTC.
   */
  endsAt                   DateTime              @map("ends_at")
  /**
   * Timezone do utilizador no momento do agendamento (ex.: America/Sao_Paulo).
   */
  timezone                 String
  /**
   * Cadeia de histórico de reagendamentos (booking anterior).
   */
  rescheduledFromBookingId String?               @map("rescheduled_from_booking_id")
  rescheduledFromBooking   RafaCallBooking?      @relation("RafaCallRescheduleChain", fields: [rescheduledFromBookingId], references: [id], onDelete: SetNull)
  reschedulesTo            RafaCallBooking[]     @relation("RafaCallRescheduleChain")
  cancelledAt              DateTime?             @map("cancelled_at")
  cancelReason             String?               @map("cancel_reason")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([guestWhatsapp, status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("rafa_call_bookings")
}

/**
 * Token criado quando um guest paga a taxa de agendamento mas ainda não escolheu data/hora.
 * Após pagar, o success URL recebe o id do unlock e o utilizador escolhe o slot.
 * Ao criar o booking, o unlock é marcado como consumido.
 */
model RafaCallGuestUnlock {
  id                      String    @id @default(cuid())
  name                    String
  /**
   * WhatsApp normalizado (dígitos com indicativo).
   */
  whatsapp                String
  stripeCheckoutSessionId String?   @unique @map("stripe_checkout_session_id")
  /**
   * Confirmado quando o webhook do Stripe confirma o pagamento.
   */
  paidAt                  DateTime? @map("paid_at")
  /**
   * Marcado quando o guest cria o booking.
   */
  consumedAt              DateTime? @map("consumed_at")
  /**
   * Booking criado a partir deste unlock (auditoria).
   */
  consumedBookingId       String?   @map("consumed_booking_id")
  /**
   * Após esta data o unlock deixa de ser válido (caso o user não agende).
   */
  expiresAt               DateTime  @map("expires_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([whatsapp])
  @@index([paidAt])
  @@map("rafa_call_guest_unlocks")
}

model RafaCallBlockedSlot {
  id              String   @id @default(cuid())
  /**
   * Intervalo em UTC.
   */
  startsAt        DateTime @map("starts_at")
  /**
   * Intervalo em UTC.
   */
  endsAt          DateTime @map("ends_at")
  /**
   * Motivo opcional (ex.: "férias", "indisponível").
   */
  reason          String?  @map("reason")
  /**
   * Quem bloqueou (admin).
   */
  createdByUserId String   @map("created_by_user_id")
  createdByUser   User     @relation("RafaCallBlockedSlotsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([endsAt])
  @@index([createdByUserId])
  @@map("rafa_call_blocked_slots")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  status               SubscriptionStatus @default(ACTIVE)
  validUntil           DateTime           @map("valid_until")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
}

/// Pagamento de anuidade contabilizado no total admin (histórico imune a mudanças de preço em env).
model MembershipPayment {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String?  @unique @map("stripe_checkout_session_id")
  stripeInvoiceId         String?  @unique @map("stripe_invoice_id")
  amountCreditedEur       Decimal  @map("amount_credited_eur") @db.Decimal(12, 2)
  stripeCurrency          String?  @map("stripe_currency")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("membership_payments")
}

/// Pagamento da taxa de agendamento (videochamada Rafa) via Stripe — só webhook `rafa_call_unlock`. Liberação manual pelo admin não cria linhas.
model RafaCallUnlockPayment {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String?  @unique @map("stripe_checkout_session_id")
  amountCreditedEur       Decimal  @map("amount_credited_eur") @db.Decimal(12, 2)
  stripeCurrency          String?  @map("stripe_currency")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("rafa_call_unlock_payments")
}

model Partner {
  id                         String   @id @default(cuid())
  userId                     String   @unique @map("user_id")
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                       String
  whatsapp                   String
  logoUrl                    String?  @map("logo_url")
  shortDescription           String?  @map("short_description")
  fullDescription            String?  @map("full_description")
  rpmCommissionPercent       Float?   @map("rpm_commission_percent")
  backgroundImageUrl         String?  @map("background_image_url")
  catalogImageUrls           String[] @default([]) @map("catalog_image_urls")
  /// Vídeo único exibido na página pública antes do carrossel de imagens (URL absoluta ou `/uploads/...`).
  catalogVideoUrl            String?  @map("catalog_video_url")
  instagram                  String?  @map("instagram")
  /// Dados de faturação (para emissão de fatura da comissão em Portugal)
  billingName                String?  @map("billing_name")
  billingNif                 String?  @map("billing_nif")
  billingAddress             String?  @map("billing_address")
  billingPostalCode          String?  @map("billing_postal_code")
  /// Slug da categoria do parceiro (constante do projeto: `relocation`, `financiamento` ou
  /// `outras`). Substitui a antiga FK `categoryId` para `ProductCategory`. Validado no
  /// app layer (`isPartnerCategorySlug`).
  categorySlug               String?  @map("category_slug")
  /// Contador de ações "partilhar" (abrir o fluxo e registar partilha).
  shareCount                 Int      @default(0) @map("share_count")
  /// Prioridade do parceiro dentro da categoria (admin). Maior = mais prioritário.
  priority                   Int      @default(0) @map("priority")
  /// Saldo para publicação de imóveis (cêntimos EUR); controlado no backend.
  advertisingBalanceEurCents Int      @default(0) @map("advertising_balance_eur_cents")
  /// URL pública curta (ex.: /maria-silva-a1b2c3). Null = página ainda não publicada. Única quando definida.
  publicSlug                 String?  @unique @map("public_slug")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  services                 Service[]
  sales                    PartnerSale[]
  houses                   PartnerHouse[]
  reactions                PartnerReaction[]
  comments                 PartnerComment[]
  advertisingLedgerEntries PartnerAdvertisingLedgerEntry[]
  /// Leads atribuídos a este parceiro (round-robin total-time entre parceiros da categoria
  /// `financiamento`). Ver `LeadsService.createForFinancingQuiz`.
  leads                    Lead[]
  /// Grupos de WhatsApp monitorizados cujos anúncios são atribuídos a este parceiro (Whatsapp scan).
  whatsappScanGroups       WhatsappScanGroup[]
  /// Link rastreado do botão «Entre em contato» na hero da página pública.
  heroShareLinkId          String?                         @unique @map("hero_share_link_id")
  heroShareLink            PartnerShareLink?               @relation("PartnerHeroShareLink", fields: [heroShareLinkId], references: [id], onDelete: SetNull)
}

/// Lead capturado pelo questionário público `/financiamento`. Atribuído a um parceiro da
/// categoria `financiamento` via round-robin (parceiro com menos leads no total ganha o
/// próximo lead). O lead pode enviar documentos diretamente para o email do parceiro via
/// `/leads/{id}/documentos` (ver `LeadDocumentSubmission`). Sem máquina de estados —
/// listagem cronológica simples no dashboard do parceiro.
model Lead {
  id            String                   @id @default(cuid())
  /// ID público numérico para exibição no dashboard (6 dígitos).
  publicId      Int                      @unique @default(dbgenerated("nextval('\"leads_public_id_seq\"'::regclass)")) @map("public_id")
  name          String
  whatsapp      String
  email         String
  /// Conteúdo completo (resumo do quiz + classificação + respostas detalhadas) usado no email
  /// enviado ao parceiro e ao lead.
  comment       String?                  @db.Text
  /// Chave da classificação retornada pelo motor do quiz (ex.: `outcomeOk`, `notNow`, ...).
  outcomeKey    String?                  @map("outcome_key")
  partnerId     String                   @map("partner_id")
  partner       Partner                  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// Timestamp do primeiro envio de documentos (qualquer modo). `null` = ainda não enviou.
  /// Usamos isto para destacar no dashboard «Meus leads» quem já entregou docs.
  docsSentAt    DateTime?                @map("docs_sent_at")
  /// Status operacional da gestora para este lead.
  status        LeadGestoraStatus?       @map("status")
  /// Agenda da gestora: quando deve ser feito o próximo contacto (UTC). `null` = sem agendamento.
  nextContactAt DateTime?                @map("next_contact_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  submissions   LeadDocumentSubmission[]

  @@index([partnerId, createdAt])
  @@index([partnerId, nextContactAt])
  @@index([partnerId, status])
  @@map("leads")
}

/// Histórico de envios de documentos por um lead. Cada submit do formulário de upload cria
/// uma linha (modo principal, cônjuge ou envio extra). Não guardamos os ficheiros — vão
/// direto para o email do parceiro como attachments e ficam apenas no IndexedDB do
/// dispositivo do lead até serem enviados.
model LeadDocumentSubmission {
  id             String   @id @default(cuid())
  leadId         String   @map("lead_id")
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// `main` = primeiro envio do próprio lead. `spouse` = envio dos documentos do cônjuge.
  /// `extra` = envios adicionais (correções, anexos em falta) após o `main`.
  mode           String
  /// Número de ficheiros anexados ao email enviado ao parceiro.
  documentCount  Int      @map("document_count")
  /// Vínculo laboral declarado neste envio (ex.: «Contrato Efetivo», «Contrato temporário»,
  /// «Recibos verdes»). Guardado para auditoria — não é mostrado ao parceiro no dashboard.
  vinculoLaboral String?  @map("vinculo_laboral")
  /// Estado civil declarado neste envio. Igual ao vínculo: meramente para auditoria.
  estadoCivil    String?  @map("estado_civil")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  @@index([leadId, submittedAt])
  @@map("lead_document_submissions")
}

model PartnerReaction {
  id        String              @id @default(cuid())
  partnerId String              @map("partner_id")
  partner   Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// Utilizador autenticado (exclusivo com `deviceId`).
  userId    String?             @map("user_id")
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Visitante: UUID persistente no browser (cabecalho `X-Partner-Device-Id`).
  deviceId  String?             @map("device_id") @db.VarChar(64)
  type      PartnerReactionType
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([type])
  @@index([partnerId, userId])
  @@index([partnerId, deviceId])
  @@map("partner_reactions")
}

model PartnerComment {
  id        String           @id @default(cuid())
  partnerId String           @map("partner_id")
  partner   Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// Autor com conta (exclusivo com `deviceId` para comentários de visitante).
  userId    String?          @map("user_id")
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Visitante: UUID do dispositivo (cabecalho `X-Partner-Device-Id`).
  deviceId  String?          @map("device_id") @db.VarChar(64)
  /// Nome opcional mostrado para comentários de visitante.
  guestName String?          @map("guest_name") @db.VarChar(120)
  body      String
  /// Comentário pai, quando é resposta a outro (thread / cascata).
  parentId  String?          @map("parent_id")
  parent    PartnerComment?  @relation("PartnerCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PartnerComment[] @relation("PartnerCommentReplies")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([partnerId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@map("partner_comments")
}

model PartnerHouse {
  id                 String                        @id @default(cuid())
  /// Número sequencial para controlo e referência (listagens, WhatsApp: «Id: …»).
  houseId            Int                           @unique @default(autoincrement()) @map("house_id")
  partnerId          String                        @map("partner_id")
  partner            Partner                       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  businessType       PartnerHouseBusinessType      @default(RENT) @map("business_type")
  typology           PartnerHouseTypology          @map("typology")
  city               String
  availableFrom      DateTime                      @map("available_from")
  priceEur           String                        @map("price_eur")
  /// Valor em euros (texto livre, ex. "500" ou "500,00")
  relocationFeeEur   String                        @map("relocation_fee_eur")
  /// Número de cauções exigidas para entrada (0–12)
  caucoesCount       Int                           @default(0) @map("caucoes_count")
  /// Número de rendas antecipadas exigidas para entrada (0–12)
  rendasEntradaCount Int                           @default(0) @map("rendas_entrada_count")
  /// Imóvel mobilado (sim/não)
  furnished          Boolean                       @default(false) @map("furnished")
  // URLs públicas (WebP), ex. R2 ou /uploads/houses/
  imageUrls          String[]                      @default([]) @map("image_urls")
  /// Foto principal (preview OG / cartões); deve existir em imageUrls. Opcional — usa-se a 1.ª imagem.
  coverImageUrl      String?                       @map("cover_image_url")
  /// Vídeo opcional na página pública; envio aos grupos WhatsApp é manual (admin).
  videoUrl           String?                       @map("video_url")
  /// Thumbnail (poster) gerada do vídeo (para preview consistente em iOS/mobile).
  videoPosterUrl     String?                       @map("video_poster_url")
  /// Destaque manual pelo admin. Imóveis em destaque aparecem primeiro em /relocation/imoveis.
  featured           Boolean                       @default(false) @map("featured")
  publicationStatus  PartnerHousePublicationStatus @default(HIDDEN) @map("publication_status")
  publishedUntil     DateTime?                     @map("published_until")
  lastPublishedAt    DateTime?                     @map("last_published_at")
  /// Momento em que passou a oculto (base para mover automaticamente para a lixeira após N dias).
  hiddenAt           DateTime?                     @map("hidden_at")
  /// Momento em que foi movido para a lixeira (base para exclusão automática após N dias).
  trashedAt          DateTime?                     @map("trashed_at")
  whatsappSentAt     DateTime?                     @map("whatsapp_sent_at")
  whatsappError      String?                       @map("whatsapp_error")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  whatsappSends            PartnerHouseWhatsappSend[]
  redirectClicks           RedirectClickEvent[]
  advertisingLedgerEntries PartnerAdvertisingLedgerEntry[]

  @@index([partnerId, publicationStatus])
  @@index([publicationStatus, publishedUntil])
  @@index([publicationStatus, hiddenAt])
  @@index([publicationStatus, trashedAt])
  @@index([availableFrom])
  @@map("partner_houses")
}

model PartnerAdvertisingLedgerEntry {
  id                      String                       @id @default(cuid())
  partnerId               String                       @map("partner_id")
  partner                 Partner                      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                    PartnerAdvertisingLedgerType
  amountEurCents          Int                          @map("amount_eur_cents")
  balanceAfterEurCents    Int                          @map("balance_after_eur_cents")
  partnerHouseId          String?                      @map("partner_house_id")
  partnerHouse            PartnerHouse?                @relation(fields: [partnerHouseId], references: [id], onDelete: SetNull)
  stripeCheckoutSessionId String?                      @unique @map("stripe_checkout_session_id")
  adminUserId             String?                      @map("admin_user_id")
  note                    String?
  createdAt               DateTime                     @default(now()) @map("created_at")

  @@index([partnerId, createdAt])
  @@map("partner_advertising_ledger_entries")
}

/**
 * Link curto criado pelo admin: WhatsApp com mensagem fixa (tracking em RedirectClickEvent).
 */
model PartnerShareLink {
  id             String   @id @default(cuid())
  /**
   * Segmento da URL de entrada: /whatsapp?t=<slug>
   */
  slug           String   @unique
  title          String
  whatsappDigits String   @map("whatsapp_digits")
  whatsappPhrase String   @map("whatsapp_phrase") @db.Text
  /**
   * Quando definido, o clique redireciona para esta URL em vez de wa.me.
   */
  destinationUrl String?  @map("destination_url") @db.VarChar(2048)
  /**
   * URL pública da imagem OG (partilha WhatsApp); R2 ou `/uploads/...`.
   */
  ogImageUrl     String?  @map("og_image_url") @db.VarChar(2048)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  clicks              RedirectClickEvent[]
  recommendedServices RecommendedService[]
  heroForPartner      Partner?             @relation("PartnerHeroShareLink")
  serviceContact      Service?             @relation("ServiceContactShareLink")

  @@map("partner_share_links")
}

/**
 * Serviço em destaque no dashboard (título + link de redirecionamento WhatsApp).
 */
model RecommendedService {
  id                 String           @id @default(cuid())
  title              String
  /**
   * Imagem do card na página /servicos (R2 ou `/uploads/...`).
   */
  cardImageUrl       String?          @map("card_image_url") @db.VarChar(2048)
  partnerShareLinkId String           @map("partner_share_link_id")
  partnerShareLink   PartnerShareLink @relation(fields: [partnerShareLinkId], references: [id], onDelete: Cascade)
  sortOrder          Int              @default(0) @map("sort_order")
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([partnerShareLinkId])
  @@index([active, sortOrder])
  @@map("recommended_services")
}

model RedirectClickEvent {
  id        String            @id @default(cuid())
  kind      RedirectClickKind
  clickedAt DateTime          @default(now()) @map("clicked_at")

  /**
   * Cookie HttpOnly `rd_vid` (UUID) no domínio da API — um contador por visitante por link.
   */
  visitorKey String? @map("visitor_key") @db.VarChar(128)

  /**
   * ISO 3166-1 alpha-2 (ex.: PT); cabeçalhos CF/Vercel ou GeoIP por IP.
   */
  visitorCountryCode String? @map("visitor_country_code") @db.VarChar(2)

  partnerShareLinkId String?           @map("partner_share_link_id")
  partnerShareLink   PartnerShareLink? @relation(fields: [partnerShareLinkId], references: [id], onDelete: Cascade)

  partnerHouseId String?       @map("partner_house_id")
  partnerHouse   PartnerHouse? @relation(fields: [partnerHouseId], references: [id], onDelete: Cascade)

  @@index([kind, clickedAt])
  @@index([partnerShareLinkId, clickedAt])
  @@index([partnerHouseId, clickedAt])
  @@map("redirect_click_events")
}

/// Histórico de envios do anúncio para grupos WhatsApp (admin).
model PartnerHouseWhatsappSend {
  id      String       @id @default(cuid())
  houseId String       @map("house_id")
  house   PartnerHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  sentAt  DateTime     @default(now()) @map("sent_at")

  @@index([houseId, sentAt])
  @@map("partner_house_whatsapp_sends")
}

/// Grupos WhatsApp para envio manual de anúncios relocation (admin).
model HouseRelocationWhatsappGroup {
  id           String                   @id @default(cuid())
  name         String
  groupJid     String                   @unique @map("group_jid")
  /// Só recebe envios de imóveis com a mesma finalidade (RENT = arrendamento, SALE = venda).
  businessType PartnerHouseBusinessType @default(RENT) @map("business_type")
  active       Boolean                  @default(true)
  sortOrder    Int                      @default(0) @map("sort_order")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@index([active, businessType, sortOrder])
  @@map("house_relocation_whatsapp_groups")
}

/// Grupo de WhatsApp monitorizado (Whatsapp scan). Mensagens recebidas neste grupo (opcionalmente
/// filtradas por números específicos) são enviadas à OpenAI para identificar anúncios de imóveis e,
/// quando positivas, criam um imóvel rascunho (HIDDEN) atribuído ao parceiro relocation indicado.
model WhatsappScanGroup {
  id               String   @id @default(cuid())
  /// Parceiro (categoria `relocation`) a quem os imóveis identificados serão atribuídos.
  partnerId        String   @map("partner_id")
  partner          Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// Título do grupo (apenas para identificação no painel; opcional).
  title            String?
  /// JID do grupo (ex.: 120363...@g.us).
  groupJid         String   @unique @map("group_jid")
  /// Números (apenas dígitos) cujas mensagens são monitorizadas quando `monitorAllMembers` é false.
  monitoredNumbers String[] @default([]) @map("monitored_numbers")
  /// true = monitoriza todas as mensagens do grupo (ignora `monitoredNumbers`).
  monitorAllMembers Boolean  @default(false) @map("monitor_all_members")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  messages     WhatsappScanMessage[]
  pendingMedia WhatsappScanPendingMedia[]

  @@index([partnerId])
  @@map("whatsapp_scan_groups")
}

/// Histórico/log de cada mensagem capturada num grupo monitorizado e o resultado do processamento.
model WhatsappScanMessage {
  id                String                    @id @default(cuid())
  groupId           String                    @map("group_id")
  group             WhatsappScanGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Número (apenas dígitos) que enviou a mensagem.
  senderNumber      String                    @map("sender_number")
  /// ID da mensagem na Evolution (para deduplicação em reentregas do webhook).
  externalMessageId String?                   @unique @map("external_message_id")
  /// Texto bruto da mensagem capturada.
  rawText           String                    @map("raw_text") @db.Text
  status            WhatsappScanMessageStatus @default(received)
  /// JSON devolvido pela OpenAI (classificação + campos extraídos).
  parsedJson        Json?                     @map("parsed_json")
  /// Imóvel criado (rascunho) a partir desta mensagem, se aplicável.
  createdHouseId    String?                   @map("created_house_id")
  /// Mensagem de erro, quando `status = error`.
  error             String?                   @db.Text
  /// Momento em que a mensagem foi enviada no WhatsApp (messageTimestamp da Evolution).
  postedAt          DateTime?                 @map("posted_at")
  createdAt         DateTime                  @default(now()) @map("created_at")

  @@index([groupId, createdAt])
  @@map("whatsapp_scan_messages")
}

/// Mídia (imagem/vídeo) capturada num grupo monitorizado, à espera de ser associada ao texto do
/// anúncio. No WhatsApp as imagens chegam normalmente como mensagens separadas (uma por imagem)
/// e só depois o texto do anúncio; o vídeo vem antes do texto ou junto (na legenda). Guardamos
/// aqui a URL já carregada (R2/disco) e, quando o anúncio é criado, anexamo-la ao imóvel.
model WhatsappScanPendingMedia {
  id                String                @id @default(cuid())
  groupId           String                @map("group_id")
  group             WhatsappScanGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Número (apenas dígitos) que enviou a mídia.
  senderNumber      String                @map("sender_number")
  kind              WhatsappScanMediaKind
  /// URL pública já carregada (imagem WebP ou vídeo).
  storedUrl         String                @map("stored_url")
  /// ID da mensagem na Evolution (dedup em reentregas do webhook).
  externalMessageId String?               @unique @map("external_message_id")
  /// Log da mensagem correspondente (para atualizar o estado quando anexada).
  messageId         String?               @map("message_id")
  /// Imóvel a que a mídia foi anexada (null = ainda pendente).
  consumedByHouseId String?               @map("consumed_by_house_id")
  /// Momento em que a mídia foi enviada no WhatsApp (messageTimestamp da Evolution).
  postedAt          DateTime?             @map("posted_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  @@index([groupId, senderNumber, consumedByHouseId, createdAt])
  @@map("whatsapp_scan_pending_media")
}

/// Serviços oferecidos por um parceiro. A antiga FK `categoryId` (para `ProductCategory`)
/// foi removida porque as categorias passaram a ser constantes do projeto e nunca eram
/// gravadas em `Service` no código.
model Service {
  id                      String            @id @default(cuid())
  partnerId               String            @map("partner_id")
  partner                 Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title                   String
  description             String?
  imageUrl                String?           @map("image_url")
  price                   String?
  priceOnRequest          Boolean           @default(false) @map("price_on_request")
  rpmCommissionEur        String?           @map("rpm_commission_eur")
  whatsappMessageTemplate String?           @map("whatsapp_message_template")
  sortOrder               Int               @default(0) @map("sort_order")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  /// Link rastreado do botão «Contactar» no cartão do serviço.
  partnerShareLinkId      String?           @unique @map("partner_share_link_id")
  partnerShareLink        PartnerShareLink? @relation("ServiceContactShareLink", fields: [partnerShareLinkId], references: [id], onDelete: SetNull)

  sales PartnerSale[]

  @@index([partnerId])
}

enum PartnerSaleCommissionPaymentStatus {
  PENDING
  PAID
}

model PartnerSale {
  id        String  @id @default(cuid())
  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  amountEur String @map("amount_eur")

  commissionPaymentStatus PartnerSaleCommissionPaymentStatus @default(PENDING) @map("commission_payment_status")
  commissionSuggestedEur  String?                            @map("commission_suggested_eur")
  commissionPaidEur       String?                            @map("commission_paid_eur")

  wantsInvoice       Boolean   @default(false) @map("wants_invoice")
  invoiceName        String?   @map("invoice_name")
  invoiceNif         String?   @map("invoice_nif")
  invoiceAddress     String?   @map("invoice_address")
  invoicePostalCode  String?   @map("invoice_postal_code")
  invoiceRequestedAt DateTime? @map("invoice_requested_at")

  stripeCheckoutSessionId String?   @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?   @unique @map("stripe_payment_intent_id")
  paidAt                  DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([userId])
  @@index([serviceId])
  @@index([commissionPaymentStatus])
  @@map("partner_sales")
}

model AffiliateProfile {
